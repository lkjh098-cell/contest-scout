# Contest Scout 는 기본값만으로 동작합니다. 아래는 전부 선택 사항입니다.
#
# 이 파일은 자동으로 읽히지 않습니다. 필요한 줄만 셸에서 export 하거나
# 실행할 때 앞에 붙이세요.
#
#   CONTEST_SCOUT_DB=data/dev.sqlite3 ./start.sh

# --- 경로 --------------------------------------------------------------- #
# 다른 DB로 띄우고 싶을 때 (예: 개발용 시드 DB)
# CONTEST_SCOUT_DB=data/dev.sqlite3
# CONTEST_SCOUT_DATA_DIR=data
# CONTEST_SCOUT_CONFIG_DIR=config

# --- 실행 포트 ---------------------------------------------------------- #
# CONTEST_SCOUT_PORT=3000          # ./start.sh 가 여는 주소
# CONTEST_SCOUT_API_PORT=8000      # ./start.sh dev 의 백엔드

# --- Phase 2 (AI Evaluator) --------------------------------------------- #
# 아직 쓰이지 않습니다. evaluators/ai.py 에 LLM 호출을 붙일 때 사용하세요.
CONTEST_SCOUT_LLM_API_KEY=
CONTEST_SCOUT_LLM_MODEL=
